@model List<LostFoundAdmin.Models.ReportedItemViewModel>
@{
    ViewData["Title"] = "Reported Items";
    ViewData["Active"] = "reported";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .toolbar {
            display: flex;
            gap: 18px;
            margin-bottom: 28px;
        }

        .staff-tag {
            display: inline-block;
            margin-left: 6px;
            padding: 1px 7px;
            border-radius: 999px;
            background: #e3eefc;
            color: #1a4d99;
            font-size: 9px;
            font-weight: 600;
        }

        .search-input,
        .type-select {
            height: 50px;
            border: 1px solid #e3e8ef;
            border-radius: 10px;
            background: #f8fafc;
            font-family: inherit;
            font-size: 11px;
            color: #1f2a37;
            outline: none;
        }

        .search-input {
            flex: 1;
            max-width: 450px;
            padding: 0 18px;
        }

            .search-input::placeholder {
                color: #9aa6b4;
            }

        .type-select {
            width: 135px;
            padding: 0 14px;
            cursor: pointer;
        }

            .search-input:focus,
            .type-select:focus {
                border-color: #17396a;
            }

        .table-card {
            border: 1px solid #e3e8ef;
            border-radius: 16px;
            padding: 20px 18px;
            max-width: 980px;
            min-height: 400px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        th {
            text-align: left;
            font-weight: 400;
            font-size: 11px;
            letter-spacing: 0.5px;
            color: #5b6b7d;
            text-transform: uppercase;
            padding: 14px 10px 22px;
        }

        td {
            padding: 18px 10px;
            color: #1f2a37;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .view-link {
            color: #17396a;
            text-decoration: none;
        }

            .view-link:hover {
                text-decoration: underline;
            }

        .empty-row td {
            text-align: center;
            color: #6b7785;
            padding: 40px 0;
        }
    </style>
}

<h1>Reported Items</h1>
<p class="subtitle">Review submitted lost and found reports</p>

<div class="toolbar">
    <input type="text" id="search" class="search-input"
           placeholder="Search by item, report ID, location or email" />

    <select id="typeFilter" class="type-select">
        <option value="all">Type: All</option>
        <option value="lost">Type: Lost</option>
        <option value="found">Type: Found</option>
    </select>
</div>

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Report</th>
                <th>Item</th>
                <th>Type</th>
                <th>Location</th>
                <th>Reported By</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="reportsBody">
            @foreach (var r in Model)
            {
                var haystack = (r.Ref + " " + r.ItemName + " " + r.Location + " " + r.ReporterEmail).ToLower();
                <tr data-row data-type="@r.Type.ToLower()" data-search="@haystack">
                    <td>@r.Ref</td>
                    <td>@r.ItemName</td>
                    <td>@r.Type</td>
                    <td>@r.Location</td>
                    <td>
                        @(string.IsNullOrWhiteSpace(r.ReporterEmail) ? "—" : r.ReporterEmail)
                        @if (r.ReporterIsStaff)
                        {
                            <span class="staff-tag">Staff</span>
                        }
                    </td>
                    <td>@r.Status</td>
                    <td><a class="view-link" asp-action="Details" asp-route-id="@r.Id" asp-route-type="@r.Type">View</a></td>
                </tr>
            }
            <tr id="emptyRow" class="empty-row" style="display:none">
                <td colspan="7">No matching reports.</td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const search = document.getElementById('search');
        const typeFilter = document.getElementById('typeFilter');
        const rows = document.querySelectorAll('#reportsBody tr[data-row]');
        const emptyRow = document.getElementById('emptyRow');

        function applyFilters() {
            const q = search.value.trim().toLowerCase();
            const t = typeFilter.value;
            let visible = 0;

            rows.forEach(r => {
                const matchesText = r.dataset.search.includes(q);
                const matchesType = t === 'all' || r.dataset.type === t;
                const show = matchesText && matchesType;
                r.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            emptyRow.style.display = visible === 0 ? '' : 'none';
        }

        search.addEventListener('input', applyFilters);
        typeFilter.addEventListener('change', applyFilters);
        applyFilters();
    </script>
}