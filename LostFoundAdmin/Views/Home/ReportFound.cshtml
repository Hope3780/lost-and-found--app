@model LostFoundAdmin.Models.ReportFoundViewModel
@{
    ViewData["Title"] = "Report Found Item";
    ViewData["Active"] = "report";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .form-card {
            border: 1px solid #e3e8ef;
            border-radius: 16px;
            padding: 22px 28px;
            max-width: 560px;
        }
        .form-row { margin-bottom: 20px; }
        .form-row label { display: block; font-size: 11px; color: #5b6b7d; margin-bottom: 8px; }

        .field-input,
        .field-select,
        .field-textarea {
            width: 100%;
            border: 1px solid #e3e8ef;
            border-radius: 10px;
            background: #f8fafc;
            font-family: inherit;
            font-size: 12px;
            color: #1f2a37;
            outline: none;
        }
        .field-input,
        .field-select { height: 42px; padding: 0 14px; }
        .field-select { cursor: pointer; }
        .field-textarea { min-height: 90px; padding: 12px 14px; resize: vertical; }
        .field-input:focus,
        .field-select:focus,
        .field-textarea:focus { border-color: #17396a; }
        .field-input::placeholder,
        .field-textarea::placeholder { color: #9aa6b4; }

        .field-error { display: block; color: #b42318; font-size: 11px; margin-top: 6px; }
        .form-error { color: #b42318; font-size: 12px; margin-bottom: 16px; }

        .photo-box {
            border: 1px dashed #b8c4d4;
            border-radius: 12px;
            background: #f8fafc;
            padding: 14px;
            font-size: 11px;
            color: #5b6b7d;
        }
        .photo-box input { font-size: 11px; }
        #preview {
            display: none;
            margin-top: 12px;
            max-width: 220px;
            max-height: 160px;
            border-radius: 10px;
            object-fit: cover;
        }

        .actions { display: flex; gap: 20px; margin-top: 28px; }
        .btn-save,
        .btn-cancel {
            height: 44px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 11px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
        .btn-save { width: 165px; background: #17396a; color: #fff; border: 1px solid #17396a; }
        .btn-save:hover { background: #1f4a85; }
        .btn-cancel { width: 113px; background: #fff; color: #17396a; border: 1px solid #17396a; }
        .btn-cancel:hover { background: #f0f4f9; }
    </style>
}

<h1>Report Found Item</h1>
<p class="subtitle">Record an item handed in at Protection Services. It will appear in the student app straight away.</p>

<form asp-action="ReportFound" method="post" enctype="multipart/form-data">
    <div class="form-card">

        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <div class="form-row">
            <label>Photo (optional)</label>
            <div class="photo-box">
                <input type="file" asp-for="Photo" accept="image/jpeg,image/png,image/gif,image/webp" />
                <img id="preview" alt="Photo preview" />
            </div>
            <span asp-validation-for="Photo" class="field-error"></span>
        </div>

        <div class="form-row">
            <label>What is it?</label>
            <input asp-for="ItemName" class="field-input" maxlength="120" placeholder="e.g. Black water bottle" />
            <span asp-validation-for="ItemName" class="field-error"></span>
        </div>

        <div class="form-row">
            <label>Category</label>
            <select asp-for="Category" class="field-select">
                @foreach (var c in LostFoundAdmin.Models.ReportFoundViewModel.Categories)
                {
                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                }
            </select>
        </div>

        <div class="form-row">
            <label>Description</label>
            <textarea asp-for="Description" class="field-textarea" maxlength="500"
                      placeholder="Colour, brand, scratches or anything that helps the owner recognise it"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="form-row">
            <label>Where was it found?</label>
            <input asp-for="Location" class="field-input" maxlength="120" placeholder="e.g. Library, Block A, Res A" />
            <span asp-validation-for="Location" class="field-error"></span>
        </div>

        <div class="form-row">
            <label>Date found</label>
            <input asp-for="DateFound" class="field-input" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DateFound" class="field-error"></span>
        </div>
    </div>

    <div class="actions">
        <button type="submit" class="btn-save">Submit Report</button>
        <a asp-action="ManageItems" class="btn-cancel">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        const fileInput = document.getElementById('Photo');
        const preview = document.getElementById('preview');
        fileInput.addEventListener('change', () => {
            const f = fileInput.files[0];
            if (f) {
                preview.src = URL.createObjectURL(f);
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    </script>
}