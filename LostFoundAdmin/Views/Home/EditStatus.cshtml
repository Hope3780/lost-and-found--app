@model LostFoundAdmin.Models.ManageStatusViewModel
@{
    ViewData["Title"] = "Update Item Status";
    ViewData["Active"] = "manage";
    Layout = "_AdminLayout";

    var isLost = Model.Type == "Lost";
    // The only statuses staff can choose from on this page
    var offered = new[] { "pending", "under_review", "available_for_collection", "returned" };
}

@section Styles {
    <style>
        .form-card {
            border: 1px solid #e3e8ef;
            border-radius: 16px;
            padding: 22px 28px;
            max-width: 525px;
        }

        .form-row {
            display: flex;
            align-items: flex-start;
            padding: 14px 0;
            font-size: 11px;
        }

            .form-row .label {
                width: 130px;
                color: #5b6b7d;
                flex-shrink: 0;
                padding-top: 12px;
            }

            .form-row .static {
                padding-top: 12px;
                color: #1f2a37;
            }

        /* Reported photo */
        .photo-thumb {
            width: 240px;
            height: 170px;
            border-radius: 12px;
            overflow: hidden;
            background: #eef2f7;
            display: block;
        }

            .photo-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .photo-empty {
            width: 240px;
            height: 170px;
            border-radius: 12px;
            background: #eef2f7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            color: #8a97a6;
        }

        .photo-hint {
            display: block;
            margin-top: 6px;
            font-size: 10px;
            color: #8a97a6;
        }

        .field-select,
        .field-textarea {
            width: 100%;
            max-width: 320px;
            border: 1px solid #e3e8ef;
            border-radius: 10px;
            background: #f8fafc;
            font-family: inherit;
            font-size: 11px;
            color: #1f2a37;
            outline: none;
        }

        .field-select {
            height: 42px;
            padding: 0 14px;
            cursor: pointer;
        }

        .field-textarea {
            min-height: 90px;
            padding: 12px 14px;
            resize: vertical;
        }

            .field-select:focus,
            .field-textarea:focus {
                border-color: #17396a;
            }

            .field-textarea::placeholder {
                color: #9aa6b4;
            }

        .actions {
            display: flex;
            gap: 20px;
            margin-top: 32px;
        }

        .btn-save,
        .btn-cancel {
            height: 44px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 11px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .btn-save {
            width: 165px;
            background: #17396a;
            color: #fff;
            border: 1px solid #17396a;
        }

            .btn-save:hover {
                background: #1f4a85;
            }

        .btn-cancel {
            width: 113px;
            background: #fff;
            color: #17396a;
            border: 1px solid #17396a;
        }

            .btn-cancel:hover {
                background: #f0f4f9;
            }
    </style>
}

<h1>Update Item Status</h1>
<p class="subtitle">Change the current status of @Model.Type.ToLower() report @Model.Ref</p>

<form asp-action="SaveStatus" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="type" value="@Model.Type" />

    <div class="form-card">

        <div class="form-row">
            <span class="label">Photo</span>
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <a class="photo-thumb" href="@Model.ImageUrl" target="_blank" rel="noopener">
                        <img src="@Model.ImageUrl" alt="@Model.ItemName" />
                    </a>
                    <span class="photo-hint">Click the photo to open it full size</span>
                }
                else
                {
                    <div class="photo-empty">No image uploaded</div>
                }
            </div>
        </div>

        <div class="form-row">
            <span class="label">Item</span>
            <span class="static">@Model.ItemName</span>
        </div>

        <div class="form-row">
            <span class="label">Type</span>
            <span class="static">@Model.Type</span>
        </div>

        <div class="form-row">
            <span class="label">Current Status</span>
            <span class="static">@Model.CurrentStatusLabel</span>
        </div>

        <div class="form-row">
            <span class="label" style="padding-top:14px">New Status</span>
            <select name="status" class="field-select">
                @if (!offered.Contains(Model.StatusKey))
                {
                    <option value="@Model.StatusKey" selected="selected">Keep: @Model.CurrentStatusLabel</option>
                }
                <option value="pending" selected="@(Model.StatusKey == "pending")">Pending</option>
                <option value="under_review" selected="@(Model.StatusKey == "under_review")">Under Review</option>
                <option value="available_for_collection" selected="@(Model.StatusKey == "available_for_collection")">Available for Collection</option>
                <option value="returned" selected="@(Model.StatusKey == "returned")">Collected</option>
            </select>
        </div>

        <div class="form-row">
            <span class="label" style="padding-top:14px">Staff Note</span>
            <textarea name="staffNote" class="field-textarea" maxlength="500"
                      placeholder="@(isLost ? "Add a note for the student..." : "Add collection instructions...")">@Model.StaffNote</textarea>
        </div>
    </div>

    <div class="actions">
        <button type="submit" class="btn-save">Save Status</button>
        <a asp-action="ManageItems" class="btn-cancel">Cancel</a>
    </div>
</form>
