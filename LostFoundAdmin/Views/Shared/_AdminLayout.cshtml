@{
    var active = ViewData["Active"] as string ?? "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CUT Lost &amp; Found</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1f2a37;
            background: #fff;
        }

        /* Top bar */
        .topbar {
            height: 64px;
            background: #17396a;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

        /* Shell */
        .shell {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* Sidebar */
        .sidebar {
            width: 200px;
            background: #f0f4f9;
            padding: 32px 24px 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .sidebar nav a {
                display: block;
                font-size: 12px;
                color: #3a4a5c;
                text-decoration: none;
                margin-bottom: 30px;
            }

                .sidebar nav a:hover,
                .sidebar nav a.active {
                    color: #17396a;
                    font-weight: 600;
                }

        /* Log Out (a button inside a form, styled like the old link) */
        .logout-form {
            margin: 0;
        }

        .logout {
            display: block;
            width: 100%;
            padding: 0;
            border: none;
            background: none;
            font-family: inherit;
            font-size: 12px;
            font-weight: 600;
            color: #1f2a37;
            text-align: center;
            cursor: pointer;
        }

            .logout:hover {
                color: #b42318;
            }

        /* Main area */
        .main {
            flex: 1;
            padding: 32px 36px 40px;
            min-width: 0;
        }

            .main h1 {
                font-size: 13px;
                font-weight: 600;
                margin: 0 0 14px;
            }

        .subtitle {
            font-size: 11px;
            color: #6b7785;
            margin: 0 0 32px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="topbar">
        <div>CUT LOST &amp; FOUND</div>
        <div>Protection Services &bull;</div>
    </header>

    <div class="shell">
        <aside class="sidebar">
            <nav>
                <a asp-controller="Home" asp-action="Index"
                   class="@(active == "dashboard" ? "active" : "")">Dashboard</a>
                <a asp-controller="Home" asp-action="ManageItems"
                   class="@(active == "manage" ? "active" : "")">Manage Reported Items</a>
                <a asp-controller="Home" asp-action="ReportFound"
                   class="@(active == "report" ? "active" : "")">Report Found</a>
                <a asp-controller="Home" asp-action="ReportedItems"
                   class="@(active == "reported" ? "active" : "")">History</a>
            </nav>

            <form asp-controller="Home" asp-action="Logout" method="post" class="logout-form">
                <button type="submit" class="logout">Log Out</button>
            </form>
        </aside>

        <main class="main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>